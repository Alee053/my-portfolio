---
import '../styles/globals.css';
import Navbar from '../components/Navbar.svelte';
import ContactModal from '../components/ContactModal.svelte';
import AboutModal from '../components/AboutModal.svelte';
import SEO from '../components/SEO.astro';
import { SITE } from '../lib/site';
import { ClientRouter } from 'astro:transitions';

interface Props {
    title?: string;
    description?: string;
    image?: string;
    imageAlt?: string;
    type?: 'website' | 'article';
    publishDate?: Date;
    keywords?: string[];
    robots?: string;
    structuredData?: Record<string, unknown>[];
}

const {
    title,
    description = SITE.description,
    image,
    imageAlt,
    type,
    publishDate,
    keywords,
    robots,
    structuredData,
} = Astro.props;

const fullTitle = title ? `${title} | ${SITE.name}` : SITE.defaultTitle;
---

<!doctype html>
<html lang={SITE.language}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link
            rel="icon"
            href="/favicon-32.png"
            type="image/png"
            sizes="32x32"
        />
        <link
            rel="icon"
            href="/logo.svg?v=ac"
            type="image/svg+xml"
            sizes="any"
        />
        <meta name="theme-color" content="#000000" />
        <title>{fullTitle}</title>
        <SEO
            title={fullTitle}
            headline={title ?? SITE.name}
            description={description}
            image={image}
            imageAlt={imageAlt}
            type={type}
            publishDate={publishDate}
            keywords={keywords}
            robots={robots}
            structuredData={structuredData}
        />
        <link
            rel="preload"
            href="/fonts/geist-mono-latin.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <ClientRouter />

        <slot name="head" />
    </head>
    <body class="site-shell">
        <a href="#main" class="skip-link">
            Skip to content
        </a>
        <div class="workspace">
            <header class="session-bar">
                <div>
                    <span class="session-bar__mark" aria-hidden="true">
                        ▣
                    </span>
                    <span class="session-bar__identity">ale@portfolio</span>{' '}
                    <span aria-hidden="true">: ~</span>
                </div>
                <div class="session-bar__location">
                    Cochabamba, Bolivia <span aria-hidden="true">/</span> UTC−4
                </div>
            </header>
            <div class="workspace-grid">
                <Navbar
                    initialPath={Astro.url.pathname}
                    client:load
                    transition:persist="navbar"
                />
                <main id="main" class="site-main" tabindex="-1">
                    <div class="page-container">
                        <slot />
                    </div>
                </main>
            </div>
            <footer class="site-footer">
                <span>© {new Date().getFullYear()} Alejandro Castro</span>
                <a href={`mailto:${SITE.email}`}>
                    {SITE.email} <span aria-hidden="true">↗</span>
                </a>
            </footer>
        </div>
        <!-- About Modal -->
        <AboutModal client:load transition:persist="about-modal" />

        <!-- Contact Modal -->
        <ContactModal
            client:load
            transition:persist="contact-modal"
            githubUrl={SITE.github}
            linkedInUrl={SITE.linkedin}
            email={SITE.email}
        />
    </body>
</html>
