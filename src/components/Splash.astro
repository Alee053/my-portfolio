---
// Boot-sequence splash. Self-contained: the inline script below runs
// synchronously before first paint and decides whether the overlay shows.
// Without JS the overlay never appears (hidden unless html[data-boot="run"]).
---
<script is:inline>
  (function () {
    var run = false;
    try {
      // readyState === 'loading' limits the splash to real document loads,
      // never after a client-side (view transition) navigation
      run = document.readyState === 'loading'
        && !sessionStorage.getItem('boot-done')
        && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    } catch (e) {}
    window.__bootRan = run;
    if (run) {
      document.documentElement.setAttribute('data-boot', 'run');
      // Failsafe: never trap the user behind the overlay
      window.__bootFailsafe = setTimeout(function () {
        if (document.documentElement.getAttribute('data-boot') === 'run' && !window.__bootDone) {
          window.__bootDone = true;
          document.documentElement.removeAttribute('data-boot');
          document.dispatchEvent(new CustomEvent('boot:done'));
        }
      }, 4000);
    } else {
      window.__bootDone = true;
    }
  })();
</script>

<div id="boot-splash" aria-hidden="true">
  <div class="boot-box">
    <div class="boot-line boot-label" data-step="0">ALECASTRO.DEV / GLASS LAB</div>
    <div class="boot-line" data-step="1">LOADING ASSETS... <span class="boot-ok">READY</span></div>
    <div class="boot-line" data-step="2">CALIBRATING SURFACES... <span class="boot-ok">READY</span></div>
    <div class="boot-line" data-step="3"><span id="boot-bar">░░░░░░░░░░░░░░░░░░░░</span> <span id="boot-pct">0%</span></div>
    <div class="boot-line" data-step="4">&gt; INITIALIZE PORTFOLIO<span class="boot-cursor">_</span></div>
  </div>
</div>

<style>
  #boot-splash {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: #061114;
    align-items: center;
    justify-content: center;
    opacity: 1;
    padding: 1.5rem;
    transition: opacity 0.2s ease;
    cursor: pointer;
  }

  #boot-splash::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: none;
  }

  html[data-boot="run"] #boot-splash {
    display: flex;
  }

  #boot-splash.boot-exit {
    opacity: 0;
    pointer-events: none;
  }

  .boot-box {
    position: relative;
    width: min(100%, 30rem);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 2;
    color: var(--ink-text);
    letter-spacing: 0.05em;
    padding: clamp(1.5rem, 5vw, 2.5rem);
    border: 1px solid var(--ink-line);
    border-radius: 1.25rem;
    background: #081b1f;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.36), 0 0 60px rgba(101, 231, 189, 0.08);
  }

  @supports (backdrop-filter: blur(1px)) {
    .boot-box {
      background: rgba(8, 27, 31, 0.78);
      backdrop-filter: blur(22px);
    }

    #boot-splash::before {
      background: radial-gradient(circle at 50% 35%, rgba(101, 231, 189, 0.16), transparent 58%);
    }
  }

  .boot-line {
    visibility: hidden;
    overflow-wrap: anywhere;
  }

  .boot-label {
    color: var(--ink-cyan);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
  }

  .boot-line[data-step="3"] {
    white-space: nowrap;
  }

  .boot-line.on {
    visibility: visible;
  }

  .boot-ok {
    color: var(--ink-accent);
  }

  .boot-cursor {
    animation: boot-blink 1s steps(1) infinite;
    color: var(--ink-accent);
  }

  @keyframes boot-blink {
    50% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .boot-cursor {
      animation: none;
    }
  }
</style>

<script>
  const splash = document.getElementById('boot-splash');
  const running = document.documentElement.getAttribute('data-boot') === 'run';

  if (splash && running) {
    const lines = splash.querySelectorAll<HTMLElement>('.boot-line');
    const bar = document.getElementById('boot-bar');
    const pct = document.getElementById('boot-pct');
    const timers: ReturnType<typeof setTimeout>[] = [];
    const failsafe = (window as any).__bootFailsafe;
    let finished = false;

    const showLine = (step: number) => lines[step]?.classList.add('on');

    const setProgress = (fraction: number) => {
      const cells = 20;
      const filled = Math.round(cells * fraction);
      if (bar) bar.textContent = '█'.repeat(filled) + '░'.repeat(cells - filled);
      if (pct) pct.textContent = `${Math.round(fraction * 100)}%`;
    };

    const finish = () => {
      if (finished) return;
      finished = true;
      timers.forEach(clearTimeout);
      if (failsafe) {
        clearTimeout(failsafe);
        (window as any).__bootFailsafe = undefined;
      }
      splash.removeEventListener('click', finish);
      window.removeEventListener('keydown', finish);
      document.removeEventListener('astro:before-swap', handleBeforeSwap);
      document.removeEventListener('boot:done', finish);
      try { sessionStorage.setItem('boot-done', '1'); } catch {}
      lines.forEach((line) => line.classList.add('on'));
      setProgress(1);
      // Signal at fade start so the hero animation begins under the fade
      (window as any).__bootDone = true;
      document.dispatchEvent(new CustomEvent('boot:done'));
      splash.classList.add('boot-exit');
      timers.push(setTimeout(() => {
        document.documentElement.removeAttribute('data-boot');
      }, 200));
    };

    const handleBeforeSwap = () => finish();
    const at = (ms: number, fn: () => void) => timers.push(setTimeout(fn, ms));

    at(0, () => showLine(0));
    at(140, () => showLine(1));
    at(300, () => showLine(2));
    at(380, () => showLine(3));
    const steps = [0.13, 0.31, 0.47, 0.62, 0.78, 0.91, 1];
    steps.forEach((fraction, i) => at(420 + i * 80, () => setProgress(fraction)));
    at(920, () => showLine(4));
    at(1150, finish);

    // Skippable with click or any key
    splash.addEventListener('click', finish, { once: true });
    window.addEventListener('keydown', finish, { once: true });
    document.addEventListener('astro:before-swap', handleBeforeSwap);
    document.addEventListener('boot:done', finish, { once: true });
  }
</script>
