---
import { SITE } from '../lib/site';

type JsonLdNode = Record<string, unknown>;

interface Props {
    title: string;
    description: string;
    headline?: string;
    image?: string;
    imageAlt?: string;
    type?: 'website' | 'article';
    publishDate?: Date;
    keywords?: string[];
    robots?: string;
    structuredData?: JsonLdNode[];
}

const {
    title,
    description,
    headline = title,
    image = SITE.image,
    imageAlt = SITE.imageAlt,
    type = 'website',
    publishDate,
    keywords = [],
    robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
    structuredData = [],
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, SITE.url).toString();
const imageUrl = new URL(image, SITE.url).toString();
const personId = `${SITE.url}/#person`;
const websiteId = `${SITE.url}/#website`;
const pageId = `${canonicalUrl}#page`;

const person = {
    '@type': 'Person',
    '@id': personId,
    name: SITE.name,
    url: SITE.url,
    email: SITE.email,
    jobTitle: SITE.role,
    description: SITE.description,
    sameAs: [SITE.github, SITE.linkedin],
    affiliation: {
        '@type': 'Organization',
        name: SITE.company,
        url: SITE.companyUrl,
    },
    knowsAbout: [
        'Software engineering',
        'Systems engineering',
        'SaaS products',
        'Full-stack development',
        'Entrepreneurship',
        'Applied AI',
        'Algorithms',
        'Reinforcement learning',
    ],
};

const website = {
    '@type': 'WebSite',
    '@id': websiteId,
    name: SITE.name,
    url: SITE.url,
    description: SITE.description,
    inLanguage: SITE.language,
    publisher: { '@id': personId },
};

const pageSchema = type === 'article'
    ? {
        '@type': 'BlogPosting',
        '@id': pageId,
        headline,
        description,
        url: canonicalUrl,
        image: imageUrl,
        inLanguage: SITE.language,
        isPartOf: { '@id': websiteId },
        mainEntityOfPage: canonicalUrl,
        author: { '@id': personId },
        publisher: { '@id': personId },
        ...(publishDate && { datePublished: publishDate.toISOString() }),
        ...(keywords.length > 0 && { keywords }),
    }
    : {
        '@type': 'WebPage',
        '@id': pageId,
        name: title,
        description,
        url: canonicalUrl,
        inLanguage: SITE.language,
        isPartOf: { '@id': websiteId },
    };

const jsonLd = {
    '@context': 'https://schema.org',
    '@graph': [website, person, pageSchema, ...structuredData],
};

// Keep content-derived values inside JSON-LD without allowing HTML-sensitive
// characters to terminate the inline script element.
const serializedJsonLd = JSON.stringify(jsonLd)
    .replace(/</g, '\\u003c')
    .replace(/>/g, '\\u003e')
    .replace(/&/g, '\\u0026')
    .replace(/\u2028/g, '\\u2028')
    .replace(/\u2029/g, '\\u2029');
---
<meta name="description" content={description} />
<meta name="author" content={SITE.name} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonicalUrl} />
<link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-readable site summary" />

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content={SITE.name} />
{type === 'article' && publishDate && (
    <meta property="article:published_time" content={publishDate.toISOString()} />
)}
{type === 'article' && (
    <meta property="article:author" content={SITE.url} />
)}
{keywords.map((keyword) => (
    <meta property="article:tag" content={keyword} />
))}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

<script is:inline type="application/ld+json" set:html={serializedJsonLd} />
