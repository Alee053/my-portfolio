---
import Layout from '../layouts/BaseLayout.astro';
import ProjectsBrowser from '../components/ProjectsBrowser.svelte';
import { getCollection } from 'astro:content';
import { SITE } from '../lib/site';

const projectsData = (await getCollection('projects'))
    .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999))
    .map((project) => ({
        id: project.id,
        ...project.data,
    }));

const projectsUrl = new URL('/projects/', SITE.url).toString();
const description = "SaaS products and custom software built with Devs Haus, alongside Alejandro Castro's projects in AI, algorithms, robotics, and simulation.";
const structuredData = [
    {
        '@type': 'CollectionPage',
        '@id': `${projectsUrl}#collection`,
        name: 'Projects',
        url: projectsUrl,
        description,
        isPartOf: { '@id': `${SITE.url}/#website` },
        mainEntity: { '@id': `${projectsUrl}#project-list` },
    },
    {
        '@type': 'ItemList',
        '@id': `${projectsUrl}#project-list`,
        name: 'Projects by Alejandro Castro',
        numberOfItems: projectsData.length,
        itemListOrder: 'https://schema.org/ItemListOrderAscending',
        itemListElement: projectsData.map((project, index) => ({
            '@type': 'ListItem',
            position: index + 1,
            name: project.name,
            ...((project.demo_url || project.repo_url) ? { url: project.demo_url || project.repo_url } : {}),
        })),
    },
    {
        '@type': 'BreadcrumbList',
        '@id': `${projectsUrl}#breadcrumb`,
        itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
            { '@type': 'ListItem', position: 2, name: 'Projects', item: projectsUrl },
        ],
    },
];
---

<Layout
    title="Projects"
    description={description}
    structuredData={structuredData}
>
    <nav class="mb-8 flex flex-wrap items-center gap-2 font-mono text-[10px] uppercase tracking-[0.08em] text-[var(--ink-muted)]" aria-label="Breadcrumb">
        <a href="/" class="focus-ring hover:text-[var(--ink-accent)]">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Projects</span>
    </nav>
    <ProjectsBrowser projects={projectsData} client:load />
</Layout>
