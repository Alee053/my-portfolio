---
import Layout from '../layouts/BaseLayout.astro';
import SectionLabel from '../components/subcomponents/SectionLabel.svelte';
---

<Layout title="404" description="Page not found.">
    <section class="flex min-h-[60vh] flex-col justify-center py-12" aria-labelledby="not-found-title">
        <SectionLabel label="ERR 404 // ROUTE_NOT_FOUND" />
        <div class="max-w-3xl">
            <h1 id="not-found-title" class="mb-6 font-sans text-7xl font-bold leading-[0.88] tracking-[-0.07em] text-[var(--ink-text)] md:text-9xl">
                404<span class="text-brutalist-accent">_</span>
            </h1>
            <p class="mb-10 max-w-lg font-mono text-xs leading-relaxed text-[var(--ink-muted)] md:text-sm">
                THE REQUESTED ROUTE DOES NOT EXIST ON THIS SERVER. CHECK THE URL OR RETURN TO A KNOWN COORDINATE.
            </p>
            <a
                href="/"
                class="glass-panel inline-flex min-h-11 items-center gap-2 px-4 py-2 font-sans text-sm font-medium text-[var(--ink-text)] hover:border-[var(--ink-accent)] hover:text-[var(--ink-accent)]"
            >
                ← RETURN TO INDEX
            </a>
        </div>
    </section>
</Layout>
