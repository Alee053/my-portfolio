---
import Layout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../../lib/formatDate';
import { SITE } from '../../lib/site';
import '../../styles/article-typography.css';
import 'katex/dist/katex.min.css';

export async function getStaticPaths() {
    const blogs = await getCollection('blog');
    return blogs.map((blog) => ({
        params: { slug: blog.slug },
        props: { post: blog },
    }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
const articleUrl = new URL(`/blog/${post.slug}/`, SITE.url).toString();
const structuredData = [
    {
        '@type': 'BreadcrumbList',
        '@id': `${articleUrl}#breadcrumb`,
        itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
            {
                '@type': 'ListItem',
                position: 2,
                name: 'Writing',
                item: new URL('/blogs/', SITE.url).toString(),
            },
            {
                '@type': 'ListItem',
                position: 3,
                name: post.data.title,
                item: articleUrl,
            },
        ],
    },
];

// Filter to h2-h4 headings for TOC
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 4);
---

<Layout
    title={post.data.title}
    description={
        post.data.description ||
        `${post.data.title}, an article by Alejandro Castro.`
    }
    type="article"
    publishDate={new Date(post.data.date)}
    keywords={post.data.tags}
    structuredData={structuredData}
>
    <nav class="article-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="article-breadcrumb__separator" aria-hidden="true">
            /
        </span>
        <a href="/blogs/">Writing</a>
        <span class="article-breadcrumb__separator" aria-hidden="true">
            /
        </span>
        <span class="article-breadcrumb__current" aria-current="page">
            Article
        </span>
    </nav>

    <!-- Blog Header -->
    <section class="article-header">
        <div class="article-header__label" aria-hidden="true">
            $ cat ~/writing/{post.slug}.md
        </div>
        <h1>{post.data.title}</h1>
        <div class="article-meta">
            <span class="article-meta__author">
                By{' '}
                <a href="/" rel="author">
                    Alejandro Castro
                </a>
            </span>
            <time datetime={new Date(post.data.date).toISOString()}>
                {formatDate(post.data.date)}
            </time>
            {post.data.tags?.map((tag) => (
                <span class="article-tag">{tag}</span>
            ))}
            {post.data.repo_url && (
                <a
                    href={post.data.repo_url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="article-meta__repo"
                >
                    Source code ↗
                </a>
            )}
        </div>
    </section>

    <!-- A native disclosure keeps the mobile reading path short. -->
    {toc.length > 0 && (
        <details class="article-toc article-toc--mobile">
            <summary class="article-toc__summary">On this page</summary>
            <nav class="article-toc__links" aria-label="Table of contents">
                {toc.map((h) => (
                    <a
                        href={`#${h.slug}`}
                        class={`article-toc__link ${h.depth === 4 ? 'article-toc__link--depth-4' : h.depth === 3 ? 'article-toc__link--depth-3' : ''}`}
                    >
                        {h.depth >= 3 ? '└ ' : ''}
                        {h.text}
                    </a>
                ))}
            </nav>
        </details>
    )}

    <!-- Content with TOC on desktop -->
    <div class="article-shell">
        <!-- Article Content -->
        <div class="article-reading-surface overflow-x-auto">
            <article class="article-content">
                <Content />
            </article>
        </div>

        <!-- TOC Sidebar - right side on desktop -->
        {toc.length > 0 && (
            <aside
                class="article-toc article-toc--desktop"
                aria-label="Table of contents"
            >
                <div class="article-toc__label">On this page</div>
                <nav class="article-toc__links">
                    {toc.map((h) => (
                        <a
                            href={`#${h.slug}`}
                            class={`article-toc__link ${h.depth === 4 ? 'article-toc__link--depth-4' : h.depth === 3 ? 'article-toc__link--depth-3' : ''}`}
                        >
                            {h.depth >= 3 ? '└ ' : ''}
                            {h.text}
                        </a>
                    ))}
                </nav>
            </aside>
        )}
    </div>

    <!-- Back to blogs link -->
    <div class="article-footer">
        <a href="/blogs/" class="article-back-link">
            ← Back to writing
        </a>
    </div>
</Layout>

<script>
    function initCopyButtons() {
        document.querySelectorAll('.article-content pre').forEach((pre) => {
            if (pre.querySelector('.copy-btn')) return;
            const btn = document.createElement('button');
            const defaultCopyLabel = 'Copy code to clipboard';
            const copiedCopyLabel = 'Code copied to clipboard';
            const errorCopyLabel = 'Unable to copy code';
            btn.type = 'button';
            btn.className = 'copy-btn';
            btn.textContent = 'COPY';
            btn.setAttribute('aria-label', defaultCopyLabel);
            const status = document.createElement('span');
            status.className = 'copy-status';
            status.setAttribute('role', 'status');
            status.setAttribute('aria-live', 'polite');
            status.setAttribute('aria-atomic', 'true');
            let resetTimer: number | null = null;
            let copyVersion = 0;
            btn.addEventListener('click', async () => {
                const requestVersion = ++copyVersion;
                if (resetTimer !== null) {
                    window.clearTimeout(resetTimer);
                    resetTimer = null;
                }
                const code = pre.querySelector('code')?.textContent ?? '';
                try {
                    await navigator.clipboard.writeText(code);
                    if (requestVersion !== copyVersion) return;
                    btn.textContent = 'COPIED';
                    btn.setAttribute('aria-label', copiedCopyLabel);
                    status.textContent = copiedCopyLabel;
                    btn.classList.add('copied');
                } catch {
                    if (requestVersion !== copyVersion) return;
                    btn.classList.remove('copied');
                    btn.textContent = 'ERROR';
                    btn.setAttribute('aria-label', errorCopyLabel);
                    status.textContent = errorCopyLabel;
                }
                resetTimer = window.setTimeout(() => {
                    if (requestVersion !== copyVersion) return;
                    btn.textContent = 'COPY';
                    btn.setAttribute('aria-label', defaultCopyLabel);
                    status.textContent = '';
                    btn.classList.remove('copied');
                    resetTimer = null;
                }, 1500);
            });
            pre.appendChild(btn);
            pre.appendChild(status);
        });
    }

    initCopyButtons();
    // Re-init after client-side navigations once ClientRouter is present
    document.addEventListener('astro:page-load', initCopyButtons);
</script>
